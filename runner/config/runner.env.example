# Copy to runner.env and edit only local, non-secret paths/settings.
# Never store a GitHub registration token here.
RUNNER_INSTALL_DIR="${HOME}/actions-runner"
RUNNER_DATA_DIR="${HOME}/.local/share/black-box-runner"
RUNNER_LABEL="black-box-linux"
# Docker is required for this v0.1 worker's container jobs.
RUNNER_REQUIRE_DOCKER="true"

# Startup cleanup may remove only Docker resources carrying this exact CI-owned label.
RUNNER_DOCKER_OWNER_LABEL="com.blackbox.runner.owner=black-box-ci"

# Host telemetry is kept in a separate protected file. Do not put the token in
# this runner configuration or commit it. The telemetry timer reads:
#   ~/.config/black-box/telemetry.env
