[Unit]
Description=Black Box GitHub Actions self-hosted runner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/actions-runner
ExecStart=%h/actions-runner/run.sh
Restart=always
RestartSec=10
Environment=RUNNER_MANUALLY_TRAP_SIG=1

# Run this as the unprivileged Ubuntu account that owns actions-runner.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only

[Install]
WantedBy=default.target
