[Unit]
Description=Black Box local reviewer status service
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/reviewer/BlackBox/reviewer
EnvironmentFile=/home/reviewer/.config/blackbox-reviewer.env
ExecStart=/usr/bin/pnpm run serve
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
