# A LUNA_API_KEY automatically selects economy_cloud_luna_v1.
# Set REVIEWER_LOCAL_ONLY=true to force static-only mode.
REVIEWER_PROFILE=economy_cloud_luna_v1
REVIEWER_ROOT=/home/reviewer/BlackBox
REVIEWER_DATA_DIR=/home/reviewer/data
REVIEWER_MAX_ATTEMPTS=4
REVIEWER_MAX_INPUT_TOKENS=32768
REVIEWER_MAX_OUTPUT_TOKENS=4096
REVIEWER_MAX_PACKET_BYTES=131072
REVIEWER_MAX_INLINE_FINDINGS=5
REVIEWER_CLOUD_BUDGET_USD=0.10
REVIEWER_STATUS_TOKEN=replace-with-a-local-random-token
REVIEWER_STATUS_PORT=8787
# LUNA_API_KEY is read from protected local storage and never committed.
# TOKENROUTER_API_KEY is separate from LUNA_API_KEY.
# GITHUB_TOKEN or an authenticated gh CLI session is used only by pr-review for PR comments.
